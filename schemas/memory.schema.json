{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline agent memory record v1",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "scope",
    "kind",
    "title",
    "body",
    "status",
    "classification",
    "confidence",
    "tags",
    "sources",
    "created_at",
    "updated_at",
    "review_after",
    "expires_at",
    "supersedes",
    "history"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^mem-[0-9a-f]{32}$"
    },
    "scope": {
      "enum": [
        "shared",
        "personal",
        "software",
        "business"
      ]
    },
    "kind": {
      "enum": [
        "fact",
        "preference",
        "procedure",
        "decision",
        "episode",
        "lesson",
        "entity"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24000
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "disputed",
        "deprecated",
        "archived"
      ]
    },
    "classification": {
      "enum": [
        "public",
        "internal",
        "private",
        "restricted"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "ref",
          "excerpt"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "excerpt": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_after": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "supersedes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^mem-[0-9a-f]{32}$"
      }
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "at",
          "actor",
          "action",
          "reason"
        ],
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "description": "Portable schema documentation. The CLI uses its own stricter validation and does not fetch this URI.",
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "const": "shared"
          }
        }
      },
      "then": {
        "properties": {
          "classification": {
            "enum": [
              "public",
              "internal"
            ]
          }
        }
      }
    }
  ]
}
